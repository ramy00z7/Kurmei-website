# Public site configuration
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SUPPORT_URL=

# Google AdSense — leave blank until the site is approved/configured
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_HOME_SLOT=

# Production services to add later
DATABASE_URL=
AUTH_SECRET=
OBJECT_STORAGE_BUCKET=
LLM_API_KEY=

# Admin access (admin stays locked until both are set)
ADMIN_PASSWORD=
# AUTH_SECRET must be 32+ random characters, e.g. `openssl rand -hex 32`

# Book Agent (Anthropic API by default)
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
# LLM_BASE_URL=https://api.anthropic.com

# Use ChatGPT or any OpenAI-compatible model instead:
# LLM_PROVIDER=openai
# LLM_MODEL=<model name from your provider>
# LLM_BASE_URL=https://api.openai.com   (change for Gemini/Mistral/local)
